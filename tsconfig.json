{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@cinefix/types": ["packages/types/src"],
      "@cinefix/utils": ["packages/utils/src"],
      "@cinefix/locales": ["packages/locales/src"],
      "@cinefix/api-client": ["packages/api-client/src"],
      "@cinefix/realtime": ["packages/realtime/src"],
      "@cinefix/ui": ["packages/ui/src"],
      "*": ["src/*"]
    }
  },
  "include": ["src", "packages"]
}
